{
  "name": "ilac-takip",
  "version": "1.0.0",
  "private": true,
  "description": "İlaç Takip PWA -> Capacitor Android (cloud build)",
  "main": "app.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "python -m http.server 8000 --directory www",
    "build": "esbuild app.js --bundle --minify --format=iife --platform=browser --target=es2019 --outfile=www/app.bundle.js",
    "android:icon": "node scripts/copy-icon.cjs",
    "postinstall": "node scripts/copy-icon.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "esbuild": "^0.24.0"
  }
}
