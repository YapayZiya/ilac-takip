{
  "name": "ilac-takip",
  "version": "1.0.0",
  "private": true,
  "description": "Çoklu hasta destekli, PIN korumalı ilaç hatırlatma uygulaması (PWA + Capacitor Android)",
  "type": "module",
  "scripts": {
    "start": "python -m http.server 8000 --directory www",
    "build:sound": "node scripts/generate-alarm-sound.cjs",
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./www/tailwind.css --minify",
    "build:js": "esbuild app.js --bundle --minify --format=iife --platform=browser --target=es2019 --outfile=www/app.bundle.js",
    "build": "npm run build:sound && npm run build:css && npm run build:js",
    "android:icon": "node scripts/copy-icon.cjs",
    "postinstall": "node scripts/copy-icon.cjs && node scripts/generate-alarm-sound.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@ilac/exact-alarm": "file:./plugins/exact-alarm"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/cli": "^4.1.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0"
  }
}
